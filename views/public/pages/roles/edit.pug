        // partial
        .main-panel
          .content-wrapper
            .col-12.grid-margin.stretch-card
              .card
                .card-body
                  h4.card-title Rolni tahrirlsh
                  p.card-description Tizim rolni yangilash
                  form(action='/role/update/'+id, method='POST').forms-sample
                    .form-group
                      label(for='exampleInputName1') Rol nomi
                      input#exampleInputName1.form-control(type='text',name="name",placeholder='Rol nomi',value=name)
                      input#roleHasTasks.form-control(type='text',name="tasks",hidden='')
                    .card-body
                      p.card-description Rol uchun vazifalarni tanlang.
                      .row
                        - var counter = 0
                        - for (var i = 2; i > 0; i--)
                          .col-md-6
                            .form-group
                              - for (var x = counter; x < Math.ceil(tasks.length/i); x++)
                                case x%5
                                  when 0
                                    .form-check.form-check-primary
                                      label(title= tasks[x].description).form-check-label
                                        if tasks_role.includes(tasks[x].name)
                                          input.form-check-input(type='checkbox',value=tasks[x].id,checked='')
                                          |  #{tasks[x].name}
                                        else 
                                          input.form-check-input(type='checkbox',value=tasks[x].id)
                                          |  #{tasks[x].name}
                                  when 1
                                    .form-check.form-check-success
                                      label(title= tasks[x].description).form-check-label
                                        if tasks_role.includes(tasks[x].name)
                                          input.form-check-input(type='checkbox',value=tasks[x].id,checked='')
                                          |  #{tasks[x].name}
                                        else
                                          input.form-check-input(type='checkbox',value=tasks[x].id)
                                          |  #{tasks[x].name} 
                                  when 2
                                    .form-check.form-check-info
                                      label(title= tasks[x].description).form-check-label
                                        if tasks_role.includes(tasks[x].name)
                                          input.form-check-input(type='checkbox',value=tasks[x].id,checked='')
                                          |  #{tasks[x].name}
                                        else 
                                          input.form-check-input(type='checkbox',value=tasks[x].id)
                                          |  #{tasks[x].name}
                                  when 3
                                    .form-check.form-check-danger
                                      label(title= tasks[x].description).form-check-label
                                        if tasks_role.includes(tasks[x].name)
                                          input.form-check-input(type='checkbox',value=tasks[x].id,checked='')
                                          |  #{tasks[x].name}
                                        else 
                                          input.form-check-input(type='checkbox',value=tasks[x].id)
                                          |  #{tasks[x].name}
                                  when 4
                                    .form-check.form-check-warning
                                      label(title= tasks[x].description).form-check-label
                                        if tasks_role.includes(tasks[x].name)
                                          input.form-check-input(type='checkbox',value=tasks[x].id,checked='')
                                          |  #{tasks[x].name}
                                        else 
                                          input.form-check-input(type='checkbox',value=tasks[x].id)
                                          |  #{tasks[x].name}
                              - var counter = Math.ceil(tasks.length/i)
                    button.btn.btn-primary.mr-2(type='submit') Yangilash
                    a(href="/role") 
                      button.btn.btn-dark(type='button') Bekor qilish
