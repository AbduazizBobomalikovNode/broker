                                | Mavzu nomi xabarni
                                | aniqlaydi.
                              input#publishTopic.form-control(type='text', placeholder='Mavzu nomi')
                            .form-group
                              label(for='data') Xabar
                              textarea#data.form-control(rows='10')
                                | {
                                | &quot;message&quot;: &quot;Salom bu text xabar&quot;
                                | }
                          button#publishButton.btn.btn-primary.mr-2(type='submit', style='width: 20%;') Yuborish
            .row
              .col-12.grid-margin
                .card
                  .card-body
                    .col-lg-12.grid-margin.stretch-card
                      .card
                        .card-body
                          h4.card-title Obuna bo&apos;lgan mavzudan xabar
                          .table-responsive(style='max-height: 120vh !important; overflow: auto;')
                            table.table.table-dark(style='max-height: 120vh !important; overflow: auto;')
                              thead
                                tr
                                  th(style='width: 20% !important;')  sana 
                                  th  Xabar 
                              tbody#messages(style='max-height: 80vh !important; overflow: auto;')
