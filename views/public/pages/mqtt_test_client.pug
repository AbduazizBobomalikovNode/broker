                    .row
                      p#subscriber-info.text-danger(style='width: 100%; text-align: center;')
                        | Hech qaysi mavzuga Obuna
                        | qilinmagan!
            .row
              .col-12.grid-margin
                .card
                  .card-body
                    .col-12.grid-margin.stretch-card
                      .card
                        .card-body
                          p.card-description  Mavzu nomi 
